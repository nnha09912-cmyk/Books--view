// Prisma schema for Books View
// Source of truth: docs/07_DATABASE_PLAN.md
// Phase 1: schema only, no migrations yet (see docs/12_ROADMAP.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Studio {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Studio's own business/display name — optional, since not everyone
  /// using Books View runs a studio. Greeting/display logic falls back to
  /// ownerName, then email — see lib/studio-name.ts.
  name             String?
  /// The account holder's personal full name ("Họ tên"), always collected
  /// at signup regardless of whether they gave a studio name.
  ownerName        String?
  slug             String   @unique
  email            String   @unique
  passwordHash     String
  logoUrl          String?
  description      String?
  phone            String?
  website          String?
  /// Studio Website (Website Templates_FINAL.md) fields. coverPhotoId is
  /// the site's hero/banner image, chosen from one of the Studio's own
  /// Album photos — loosely-referenced (no FK), validated at the API layer
  /// to belong to this studio before ever being saved, same pattern as
  /// Album.coverPhotoId. socialLinks is a flat {platform: url} map.
  /// Deliberately no color/branding field here: per the spec's own Studio
  /// Editor rule, the Template controls the color system, not the Studio.
  coverPhotoId     String?  @db.Uuid
  /// Short marketing tagline for the Website ("câu nói slogan") — distinct
  /// from `description`, which is the longer About-section paragraph.
  tagline          String?
  address          String?
  socialLinks      Json?
  apiKey           String?  @unique
  isActive         Boolean  @default(true)
  googleDriveToken Json?
  /// "USER" (regular Studio, the default) or "ADMIN" (System Owner —
  /// platform-wide oversight). Never settable by the client; only ever
  /// flipped by a direct database update, never through any API — see
  /// the System Owner area's own design notes.
  role             String   @default("USER")
  lastLoginAt      DateTime?
  /// Brute-force lockout — tracked in the DB (not in-memory) so it stays
  /// correct across serverless instances on Vercel, unlike a process-local
  /// counter which would reset per cold start / per instance.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Bumped whenever all previously-issued session JWTs should stop being
  /// honored (e.g. password change) — checked against the token's own
  /// embedded value in getCurrentStudio(), since sessions are stateless JWTs
  /// with no server-side store to delete rows from otherwise.
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  albums               Album[]
  permissions          Permission[]
  adminAccessLogs      AdminAccessLog[]
  passwordResetTokens  PasswordResetToken[]
  studioWebsite        StudioWebsite?
  websitePricingPlans  WebsitePricingPlan[]

  @@map("studios")
}

/// A Studio's own service-price list — what THEY charge THEIR clients,
/// shown as a price-list accordion on templates that support it (e.g. the
/// Landing Page demo template). Distinct from the SaaS's own "Gói dịch vụ"
/// billing tab (still mock UI) — that's what the Studio pays Guikhach.com,
/// this is what the Studio's own customers pay them.
model WebsitePricingPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studioId    String   @db.Uuid
  name        String
  price       String
  unit        String?
  description String?
  /// string[] of included items, rendered as a bullet list when the plan
  /// row is expanded.
  features    Json?
  orderIndex  Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("website_pricing_plans")
}

/// The Studio's public-facing marketing site (Website Templates spec) — a
/// distinct product from Album Proofing (docs: "Website Templates_FINAL.md").
/// One per Studio (1:1). Presentation only: templateId picks which of the
/// registered templates renders it, and every piece of actual content this
/// site needs (name/slug/logo/description/phone from Studio, Albums it
/// references by id) already lives elsewhere — nothing here duplicates it.
/// `settings` carries whatever a template needs that isn't a first-class
/// Studio field yet (headline override, accent color choice, etc.).
model StudioWebsite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studioId    String    @unique @db.Uuid
  templateId  String
  status      String    @default("draft") // "draft" | "published"
  publishedAt DateTime?
  settings    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studio   Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  sections WebsiteSection[]

  @@map("studio_websites")
}

/// One content block on a StudioWebsite (Hero, Portfolio, About, Albums,
/// Contact, ...) — `type` picks which section component renders,
/// `orderIndex` controls position, `enabled` lets a Studio turn one off
/// without losing its settings. `settings` is the section's own content
/// (headline text, which Album ids it shows, etc.) — free-form per type
/// rather than a column per possible field, since section shapes vary a lot
/// across 17 templates and this avoids a very wide, mostly-null table.
model WebsiteSection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId  String   @db.Uuid
  type       String
  enabled    Boolean  @default(true)
  orderIndex Int
  settings   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website StudioWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@map("website_sections")
}

/// A single-use, short-lived "Quên mật khẩu" link. Only tokenHash (never
/// the raw token) is stored, same idea as passwordHash — the raw token
/// only ever exists in the emailed link and the requester's browser.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studioId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("password_reset_tokens")
}

/// Minimal access trail for System Owner actions — deliberately not the
/// full Audit Log system (that was scoped and shelved separately). Only
/// ever written to when an ADMIN views another Studio's account or Album,
/// so "quyền xem dữ liệu nhạy cảm phải có... audit" has at least a real
/// record, without building the bigger dashboard/filtering feature.
model AdminAccessLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorStudioId String   @db.Uuid
  action        String
  resourceType  String
  resourceId    String
  createdAt     DateTime @default(now())

  actor Studio @relation(fields: [actorStudioId], references: [id], onDelete: Cascade)

  @@index([actorStudioId])
  @@map("admin_access_logs")
}

model Album {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studioId            String    @db.Uuid
  name                String
  description         String?
  slug                String?
  template            String    @default("classic")
  linkToken           String    @unique
  passwordHash        String?
  status              String    @default("active")
  expiryDate          DateTime?
  photoCount          Int       @default(0)
  googleDriveFolderId String?
  maxSelectionCount   Int?
  /// Separate from passwordHash (which gates viewing/Sao) — this gates the
  /// resized Download endpoint specifically, per Album Settings' own
  /// "Cho phép tải ảnh" toggle.
  downloadEnabled      Boolean   @default(false)
  downloadPasswordHash String?
  downloadExpiryDate   DateTime?
  /// Bumped whenever guest sessions for this album should stop being
  /// honored (Primary Password changed, or an explicit "Revoke Sessions")
  /// — checked against the value embedded in each guest JWT at sign time,
  /// the same pattern as Studio.sessionVersion.
  guestSessionVersion Int      @default(0)
  /// Loosely-referenced Photo.id (no FK — same pattern as
  /// googleDriveFolderId above), validated at the API layer to belong to
  /// this album before ever being saved. Used as the Landing Page
  /// template's background photo. coverPosY is the vertical focal point
  /// (0-100, like object-position), set via the Gallery's cover editor.
  coverPhotoId String? @db.Uuid
  coverPosY    Int?    @default(50)
  /// The wedding/graduation/event date shown on the Landing Page template
  /// (e.g. "12.12.2026") — distinct from expiryDate (the selection
  /// deadline). Optional; templates hide the date line when unset.
  eventDate DateTime?
  /// Whether this Album is shown on the Studio's public Website ("album
  /// nào demo" — Website Templates_FINAL.md). Off by default: a Studio's
  /// existing Albums are proofing links for specific clients, not
  /// automatically public marketing content, so opting one in is explicit.
  showOnWebsite Boolean @default(false)
  /// Stamped with the current time whenever a Google Drive scan
  /// (drive-import or drive-sync) actually completes successfully — never
  /// touched on failure, so the "Đồng bộ ảnh" button's tooltip always shows
  /// the last time it *worked*, not the last time it was merely attempted.
  lastGoogleSyncAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  studio    Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  folders   Folder[]
  photos    Photo[]
  customers Customer[]

  @@index([studioId])
  @@index([linkToken])
  @@map("albums")
}

model Folder {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId             String   @db.Uuid
  parentFolderId      String?  @db.Uuid
  name                String
  description         String?
  orderIndex          Int?
  googleDriveFolderId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  parentFolder Folder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders Folder[] @relation("FolderHierarchy")
  photos       Photo[]

  @@index([albumId])
  @@map("folders")
}

model Photo {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId       String   @db.Uuid
  folderId      String?  @db.Uuid
  filename      String
  originalUrl   String
  thumbnailUrl  String?
  previewUrl    String?
  width         Int?
  height        Int?
  fileSize      Int?
  mimeType      String?
  likeCount     Int      @default(0)
  starCount     Int      @default(0)
  orderIndex    Int?
  googleDriveId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  album      Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  selections Selection[]
  comments   Comment[]

  @@index([albumId])
  @@index([folderId])
  @@map("photos")
}

model Customer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId      String    @db.Uuid
  name         String
  email        String?
  phone        String?
  guestToken   String?   @unique
  lastViewedAt DateTime?
  submittedAt  DateTime?
  /// Identified via the album's shared password (couple/wedding) rather than
  /// name+phone (guests) — the only customers allowed to use Star, not just Like.
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  album      Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  selections Selection[]
  comments   Comment[]

  @@unique([albumId, email])
  @@index([albumId])
  @@map("customers")
}

model Selection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  photoId    String   @db.Uuid
  likeType   String // 'like' (♥) or 'star' (⭐)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photo    Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([customerId, photoId, likeType])
  @@index([customerId])
  @@index([photoId])
  @@map("selections")
}

model Comment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoId    String   @db.Uuid
  customerId String   @db.Uuid
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photo    Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Permission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studioId     String   @db.Uuid
  resourceType String // 'album', 'api', etc.
  resourceId   String?  @db.Uuid
  action       String // 'read', 'write', 'delete'
  createdAt    DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

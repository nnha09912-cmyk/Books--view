DATABASE_URL="postgresql://user:password@localhost:5432/booksview"

JWT_SECRET=""
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Drive API key, restricted to Google Drive API — used to read publicly
# shared ("Anyone with the link") Drive folders. No OAuth needed.
GOOGLE_DRIVE_API_KEY=""

# Transactional email (password reset, etc.)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Vercel Blob — object storage for studio avatars and Google Drive-synced
# photos (original + preview). Works from any host, not just Vercel; only
# needs a valid token from a Vercel account with Blob enabled. The SDK
# reads this env var itself — no explicit token is passed in code.
BLOB_READ_WRITE_TOKEN=""
